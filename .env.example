# 複製本檔為 .env 後填入實際值；.env 已被 .gitignore 排除。

# Firebase Admin SDK 服務帳戶金鑰檔路徑
# Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰
FIREBASE_CREDENTIALS=./firebase-mobi.json

# 綠界 ECPay 商店資訊（正式環境）
# 綠界廠商後台 > 系統開發管理 > 系統介接設定
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# HTTPS 憑證（server.py 直接以 uvicorn 啟用 TLS 時使用）
SSL_KEYFILE=./cert/privkey.pem
SSL_CERTFILE=./cert/fullchain.pem
